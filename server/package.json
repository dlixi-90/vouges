{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "init:categories": "node scripts/initializeCategories.js",
    "start": "node server.js",
    "server": "nodemon server.js",
    "test": "node --test --test-concurrency=1 tests/core/*.test.js tests/ai/*.test.js",
    "media:prepare": "node scripts/prepareProductMedia.js",
    "media:upload": "node scripts/uploadProductMedia.js",
    "media:preview": "node scripts/applyProductMedia.js",
    "media:migrate": "node scripts/migrateCloudinaryMedia.mjs",
    "catalog:preview": "node scripts/resetPerfumeCatalog.js",
    "catalog:reset": "node scripts/resetPerfumeCatalog.js --apply --database=vouges",
    "preview:email": "node scripts/previewOrderEmail.js",
    "test:ai": "node --test --test-concurrency=1 tests/ai/*.test.js",
    "test:tools": "node --test --test-concurrency=1 ../tools/apaniche/*.test.mjs",
    "test:library": "node --test --test-concurrency=1 tests/core/fragranceLibrary.test.js ../tools/apaniche/library-parser.test.mjs ../tools/apaniche/library-content.test.mjs ../tools/apaniche/library-refresh.test.mjs",
    "test:product-descriptions": "node --test ../tools/apaniche/product-descriptions.test.mjs",
    "test:product-article-media": "node --test ../tools/apaniche/product-article-media.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@clerk/express": "^2.1.63",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.9.4",
    "multer": "^2.2.0",
    "nodemailer": "^9.1.0",
    "svix": "^2.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
